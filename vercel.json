{
  "version": 2,
  "builds": [
    { "src": "api/api/*.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/products", "dest": "/api/api/products.js" },
    { "src": "/api/update", "dest": "/api/api/update.js" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/", "dest": "/index.html" }
  ]
}
